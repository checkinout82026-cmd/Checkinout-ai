rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection - prevent plaintext passwords from being stored
    match /users/{userId} {
      allow read: if true;
      allow create, update: if !('password' in request.resource.data);
      allow delete: if true;
    }
    
    // Students Collection
    match /students/{studentId} {
      allow read, write, delete: if true;
    }
    
    // Authorized Pickups Collection
    match /authorized_pickups/{pickupId} {
      allow read, write, delete: if true;
    }
    
    // Attendance Records Collection
    match /attendance/{recordId} {
      allow read, write, delete: if true;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

