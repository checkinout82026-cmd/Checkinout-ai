rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection - prevent plaintext passwords from being stored
    match /users/{userId} {
      allow read: if true;
      allow create, update: if !('password' in request.resource.data);
      allow delete: if true;
    }
    
    // Students Collections (root and regional tables)
    match /{studentCol}/{studentId} {
      allow read, write, delete: if studentCol == 'students' || studentCol.matches('^students_.*');
    }
    
    // Authorized Pickups Collections (root and regional tables)
    match /{pickupCol}/{pickupId} {
      allow read, write, delete: if pickupCol == 'authorized_pickups' || pickupCol.matches('^authorized_pickups_.*');
    }
    
    // Attendance Records Collections (root and regional tables)
    match /{attCol}/{recordId} {
      allow read, write, delete: if attCol == 'attendance' || attCol.matches('^attendance_.*');
    }

    // Schools Collection
    match /schools/{schoolId} {
      allow read: if true;
      allow write: if false; // Read-only for standard clients; provisioned by admin
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

